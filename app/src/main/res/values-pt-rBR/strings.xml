    <string name="credit_design_title">Design e ilustrações</string>
    <string name="credit_design_subtitle">Arte de</string>
    <string name="credit_design_body">As belas ilustrações e desenhos usados no Ryori foram criados por Pablo Stanley. Muito obrigado pelas contribuições incríveis à comunidade de design aberto!</string>
    <string name="credit_lordicon_title">Ícones animados</string>
    <string name="credit_lordicon_subtitle">Fornecidos pela Lordicon</string>
    <string name="credit_lordicon_body">Os ícones animados de Início e Busca na barra de navegação do Ryori são da Lordicon, uma biblioteca de recursos animados de alta qualidade para criadores.</string>
    <string name="credit_lordicon_action">Visitar a Lordicon</string>
    <string name="credit_oss_title">O Ryori é de código aberto</string>
    <string name="credit_oss_subtitle">Licenciado sob GPL-3.0</string>
    <string name="credit_oss_body">O código-fonte está disponível no GitHub. Você pode usar, estudar, modificar e compartilhar o código, desde que tudo o que compartilhar continue de código aberto sob a mesma licença. O nome e o logotipo do Ryori não estão incluídos.</string>
    <string name="credit_oss_action">Ver código-fonte</string>
    <string name="quill_feature_1_body">Um companheiro de leitura com IA que responde com base no seu livro, limitado ao seu progresso para nunca dar spoiler.</string>
    <string name="quill_feature_2_title">Guia de personagens</string>
    <string name="quill_feature_2_body">Lembre quem é alguém, o que tem feito ultimamente ou acompanhe toda a sua trajetória até agora.</string>
    <string name="quill_feature_3_title">Visualize cenas</string>
    <string name="quill_feature_3_body">Transforme um trecho em ilustração e volte direto para onde ele estava.</string>
    <string name="quill_feature_4_title">Um leitor lindo</string>
    <string name="quill_feature_4_body">Fontes, espaçamento, temas de página, destaques, luz noturna e leitura paginada ou com rolagem.</string>
    <string name="quill_feature_5_title">Biblioteca sem fim</string>
    <string name="quill_feature_5_body">Importe seus próprios EPUBs ou baixe entre mais de 60.000 títulos gratuitos do Project Gutenberg e do Standard Ebooks.</string>
    <string name="quill_feature_6_title">Estatísticas de leitura</string>
    <string name="quill_feature_6_body">Sequências, um mapa de calor de leitura, horários de pico e autores favoritos, com lembretes diários gentis.</string>
    <string name="quill_tagline">Leia mais fundo. Pense mais longe.</string>
    <string name="sessions_feature_1_title">Motor inteligente</string>
    <string name="sessions_feature_1_body">Ciclos personalizáveis e intervalos inteligentes que calculam quando fazer uma pausa longa.</string>
    <string name="sessions_feature_2_title">Áudio imersivo</string>
    <string name="sessions_feature_2_body">6 sons ambientes selecionados, com redução adaptativa de volume e resposta tátil.</string>
    <string name="sessions_feature_3_title">Análises completas</string>
    <string name="sessions_feature_3_body">Mapas de calor, tempo total de foco e seus horários mais produtivos num relance.</string>
    <string name="sessions_feature_4_title">Imbatível</string>
    <string name="sessions_feature_4_body">Feito para resistir à otimização agressiva de bateria, para que seu timer nunca pare.</string>
    <string name="sessions_feature_5_title">Temas completos</string>
    <string name="sessions_feature_5_body">8 temas de cor, Material You dinâmico, modo preto OLED e 6 fontes.</string>
    <string name="sessions_feature_6_title">Histórico de tarefas</string>
    <string name="sessions_feature_6_body">Dê nome às suas sessões para acompanhar e rever exatamente no que você trabalhou.</string>
    <string name="sessions_tagline">O timer Pomodoro definitivo</string>
    <string name="mynt_feature_1_title">É só falar</string>
    <string name="mynt_feature_1_body">Conte ao Mynt o que você gastou como contaria a um amigo. Várias coisas em uma frase viram lançamentos separados.</string>
    <string name="mynt_feature_2_title">Emprestar e pegar emprestado</string>
    <string name="mynt_feature_2_body">Diga para quem você emprestou ou de quem pegou emprestado, e quando pagaram. O Mynt mantém cada saldo em dia.</string>
    <string name="mynt_feature_3_title">Divida contas</string>
    <string name="mynt_feature_3_body">Divida um jantar ou uma viagem entre amigos só dizendo quem estava lá e quanto custou.</string>
    <string name="mynt_feature_4_title">Pergunte sobre seu dinheiro</string>
    <string name="mynt_feature_4_body">Pergunte quanto gastou com comida este mês ou quem ainda deve para você e tenha a resposta na hora.</string>
    <string name="mynt_feature_5_title">Revise antes de salvar</string>
    <string name="mynt_feature_5_body">Tudo o que o Mynt entendeu aparece primeiro, para você corrigir um valor ou uma categoria antes de salvar.</string>
    <string name="mynt_feature_6_title">Ele responde</string>
    <string name="mynt_feature_6_body">Quando falta algo, o Mynt pergunta, e pode ler as perguntas em voz alta para você responder sem as mãos.</string>
    <string name="mynt_tagline">Seu assistente financeiro por voz</string>
    <string name="hajime_feature_1_title">Aprenda a ler japonês</string>
    <string name="hajime_feature_1_body">Primeiro hiragana e katakana, depois kanji, palavras e frases, uma lição curta de cada vez.</string>
    <string name="hajime_feature_2_title">Todos os kanji do JLPT</string>
    <string name="hajime_feature_2_body">Kanji do N5 ao N1 com leituras, significados, componentes, palavras comuns e frases de exemplo com furigana.</string>
    <string name="hajime_feature_3_title">Revisões que lembram</string>
    <string name="hajime_feature_3_body">A repetição espaçada traz cada item de volta pouco antes de você esquecer, para que o aprendizado fique.</string>
    <string name="hajime_feature_4_title">Sensei, seu tutor com IA</string>
    <string name="hajime_feature_4_body">Pergunte qualquer coisa sobre japonês e receba histórias, análises de frases e quizzes feitos com o que você aprendeu.</string>
    <string name="hajime_feature_5_title">Ouça cada palavra</string>
    <string name="hajime_feature_5_body">Cada kana, kanji, palavra e frase pode ser lido em voz alta por uma voz japonesa.</string>
    <string name="hajime_feature_6_title">Estatísticas de estudo</string>
    <string name="hajime_feature_6_body">Sequências, um mapa de calor de estudo, suas confusões mais difíceis e o progresso em cada nível do JLPT.</string>
    <string name="hajime_tagline">Aprenda a ler japonês</string>
    <string name="more_apps_fact_reviews">Mais de 100 avaliações</string>
    <string name="more_apps_fact_reviews_quill">Mais de 20 avaliações</string>
    <string name="more_apps_fact_downloads">Downloads</string>
    <string name="more_apps_key_features">Principais recursos</string>
    <string name="more_apps_subtitle">Mais quatro apps, feitos com o mesmo cuidado</string>
    <string name="more_apps_intro">Se você gosta de cozinhar com o Ryori, talvez goste de ler com o Quill, controlar seu dinheiro com o Mynt, aprender japonês com o Hajime e se concentrar com o Sessions.</string>
    <string name="more_apps_get_on_play">Baixar na Play Store</string>
    <string name="more_apps_overview_title">Cozinhe. Leia. Controle. Aprenda. Concentre-se.</string>
    <string name="more_apps_overview_body">Ryori, Quill, Mynt, Hajime e Sessions são feitos pela YugenTech: apps pequenos e cuidadosos, feitos para deixar o dia a dia um pouco mais tranquilo.</string>
    <string name="more_apps_sheet_subtitle">Mais quatro apps, feitos com o mesmo cuidado.</string>
