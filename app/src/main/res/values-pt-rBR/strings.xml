    <string name="whats_new_1_title">Um início que inspira</string>
    <string name="whats_new_1_body">Um carrossel de destaques, uma culinária e uma categoria do dia, e um botão Surpreenda-me para quando você não consegue decidir.</string>
    <string name="whats_new_2_title">Explore todas as cozinhas</string>
    <string name="whats_new_2_body">Explore centenas de receitas por categoria, culinária ou ingrediente, ou busque uma pelo nome.</string>
    <string name="whats_new_3_title">Cozinhe passo a passo</string>
    <string name="whats_new_3_body">Instruções claras passo a passo, com ingredientes que você pode ir marcando.</string>
    <string name="whats_new_4_title">Drinks sem álcool</string>
    <string name="whats_new_4_body">As bebidas sem álcool ficam ao lado das refeições, então tem algo para todo copo.</string>
    <string name="whats_new_5_title">Modo vegetariano</string>
