    <string name="whats_new_3_body">清晰的分步说明，食材可以边做边勾选。</string>
    <string name="whats_new_4_title">无酒精饮品</string>
    <string name="whats_new_4_body">无酒精饮品就在菜品旁边，每个杯子都有合适的一杯。</string>
    <string name="whats_new_5_title">素食模式</string>
