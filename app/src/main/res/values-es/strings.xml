    <string name="credit_design_title">Diseño e ilustraciones</string>
    <string name="credit_design_subtitle">Ilustraciones de</string>
    <string name="credit_design_body">Las preciosas ilustraciones y dibujos de Ryori son obra de Pablo Stanley. ¡Muchas gracias por sus increíbles aportaciones a la comunidad de diseño abierto!</string>
    <string name="credit_lordicon_title">Iconos animados</string>
    <string name="credit_lordicon_subtitle">Proporcionados por Lordicon</string>
    <string name="credit_lordicon_body">Los iconos animados de Inicio y Búsqueda en la barra de navegación de Ryori son de Lordicon, una biblioteca de recursos animados de alta calidad para creadores.</string>
    <string name="credit_lordicon_action">Visitar Lordicon</string>
    <string name="credit_oss_title">Ryori es de código abierto</string>
    <string name="credit_oss_subtitle">Con licencia GPL-3.0</string>
    <string name="credit_oss_body">El código fuente está disponible en GitHub. Puedes usarlo, estudiarlo, modificarlo y compartirlo, siempre que lo que compartas siga siendo de código abierto bajo la misma licencia. El nombre y el logotipo de Ryori no están incluidos.</string>
    <string name="credit_oss_action">Ver código fuente</string>
    <string name="quill_feature_1_body">Un compañero de lectura con IA que responde a partir de tu libro, limitado a tu progreso para no revelarte lo que viene.</string>
    <string name="quill_feature_2_title">Guía de personajes</string>
    <string name="quill_feature_2_body">Recuerda quién es alguien, qué ha hecho últimamente o repasa todo su recorrido hasta ahora.</string>
    <string name="quill_feature_3_title">Visualiza escenas</string>
    <string name="quill_feature_3_body">Convierte un pasaje en una ilustración y vuelve directamente a donde estaba.</string>
    <string name="quill_feature_4_title">Un lector precioso</string>
    <string name="quill_feature_4_body">Fuentes, espaciado, temas de página, subrayados, luz nocturna y modo paginado o con desplazamiento.</string>
    <string name="quill_feature_5_title">Biblioteca infinita</string>
    <string name="quill_feature_5_body">Importa tus propios EPUB o descarga entre más de 60.000 títulos gratuitos de Project Gutenberg y Standard Ebooks.</string>
    <string name="quill_feature_6_title">Estadísticas de lectura</string>
    <string name="quill_feature_6_body">Rachas, un mapa de calor de lectura, horas punta y autores favoritos, con recordatorios diarios suaves.</string>
    <string name="quill_tagline">Lee más a fondo. Piensa más lejos.</string>
    <string name="sessions_feature_1_title">Motor inteligente</string>
    <string name="sessions_feature_1_body">Ciclos personalizables e intervalos inteligentes que deciden cuándo toca un descanso largo.</string>
    <string name="sessions_feature_2_title">Audio inmersivo</string>
    <string name="sessions_feature_2_body">6 sonidos ambientales seleccionados, con atenuación adaptativa y respuesta háptica.</string>
    <string name="sessions_feature_3_title">Análisis a fondo</string>
    <string name="sessions_feature_3_body">Mapas de calor, tiempo total de concentración y tus horas más productivas de un vistazo.</string>
    <string name="sessions_feature_4_title">Imparable</string>
    <string name="sessions_feature_4_body">Hecho para resistir la optimización agresiva de batería, para que tu temporizador nunca se detenga.</string>
    <string name="sessions_feature_5_title">Temas a fondo</string>
    <string name="sessions_feature_5_body">8 temas de color, Material You dinámico, modo negro OLED y 6 fuentes.</string>
    <string name="sessions_feature_6_title">Historial de tareas</string>
    <string name="sessions_feature_6_body">Pon nombre a tus sesiones para seguir y repasar exactamente en qué trabajaste.</string>
    <string name="sessions_tagline">El temporizador Pomodoro definitivo</string>
    <string name="mynt_feature_1_title">Solo dilo</string>
    <string name="mynt_feature_1_body">Dile a Mynt lo que gastaste como se lo contarías a un amigo. Varias cosas en una frase se convierten en entradas separadas.</string>
    <string name="mynt_feature_2_title">Prestar y pedir prestado</string>
    <string name="mynt_feature_2_body">Di a quién prestaste o de quién recibiste un préstamo, y cuándo te devolvieron. Mynt mantiene cada saldo al día.</string>
    <string name="mynt_feature_3_title">Divide cuentas</string>
    <string name="mynt_feature_3_body">Divide una cena o un viaje entre amigos con solo decir quién estuvo y cuánto costó.</string>
    <string name="mynt_feature_4_title">Pregunta por tu dinero</string>
    <string name="mynt_feature_4_body">Pregunta cuánto gastaste en comida este mes o quién te debe aún, y obtén la respuesta al momento.</string>
    <string name="mynt_feature_5_title">Revisa antes de guardar</string>
    <string name="mynt_feature_5_body">Todo lo que Mynt entendió se muestra primero, para que puedas corregir un importe o una categoría antes de guardarlo.</string>
    <string name="mynt_feature_6_title">Te responde</string>
    <string name="mynt_feature_6_body">Cuando falta algo, Mynt te pregunta y puede leer sus preguntas en voz alta para que respondas sin manos.</string>
    <string name="mynt_tagline">Tu asistente de dinero por voz</string>
    <string name="hajime_feature_1_title">Aprende a leer japonés</string>
    <string name="hajime_feature_1_body">Primero hiragana y katakana, luego kanji, palabras y frases, una lección corta cada vez.</string>
    <string name="hajime_feature_2_title">Todos los kanji del JLPT</string>
    <string name="hajime_feature_2_body">Kanji del N5 al N1 con lecturas, significados, partes, palabras comunes y frases de ejemplo con furigana.</string>
    <string name="hajime_feature_3_title">Repasos que recuerdan</string>
    <string name="hajime_feature_3_body">La repetición espaciada te devuelve cada elemento justo antes de que lo olvides, para que lo aprendido se quede.</string>
    <string name="hajime_feature_4_title">Sensei, tu tutor con IA</string>
    <string name="hajime_feature_4_body">Pregunta lo que quieras sobre el japonés y obtén historias, análisis de frases y cuestionarios basados en lo que has aprendido.</string>
    <string name="hajime_feature_5_title">Escucha cada palabra</string>
    <string name="hajime_feature_5_body">Cada kana, kanji, palabra y frase puede leerse en voz alta con una voz japonesa.</string>
    <string name="hajime_feature_6_title">Estadísticas de estudio</string>
    <string name="hajime_feature_6_body">Rachas, un mapa de calor de estudio, tus confusiones más difíciles y tu progreso en cada nivel del JLPT.</string>
    <string name="hajime_tagline">Aprende a leer japonés</string>
    <string name="more_apps_fact_reviews">Más de 100 reseñas</string>
    <string name="more_apps_fact_reviews_quill">Más de 20 reseñas</string>
