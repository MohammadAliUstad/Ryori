    <string name="more_apps_subtitle">Cuatro apps más, hechas con el mismo cuidado</string>
    <string name="more_apps_intro">Si disfrutas cocinando con Ryori, quizá te guste leer con Quill, llevar tus cuentas con Mynt, aprender japonés con Hajime y concentrarte con Sessions.</string>
    <string name="more_apps_get_on_play">Disponible en Play Store</string>
    <string name="more_apps_overview_title">Cocina. Lee. Controla. Aprende. Concéntrate.</string>
    <string name="more_apps_overview_body">Ryori, Quill, Mynt, Hajime y Sessions son de YugenTech: apps pequeñas y cuidadas para hacer cada día un poco más sereno.</string>
    <string name="more_apps_sheet_subtitle">Cuatro apps más, hechas con el mismo cuidado.</string>
