    <string name="whats_new_1_title">Un inicio que inspira</string>
    <string name="whats_new_1_body">Un carrusel destacado, una cocina y una categoría del día, y un botón Sorpréndeme para cuando no sabes qué elegir.</string>
    <string name="whats_new_2_title">Explora todas las cocinas</string>
    <string name="whats_new_2_body">Explora cientos de recetas por categoría, cocina o ingrediente, o busca una por su nombre.</string>
    <string name="whats_new_3_title">Cocina paso a paso</string>
    <string name="whats_new_3_body">Instrucciones claras paso a paso, con ingredientes que puedes ir marcando.</string>
    <string name="whats_new_4_title">Cócteles sin alcohol</string>
    <string name="whats_new_4_body">Las bebidas sin alcohol están junto a los platos, así que hay algo para cada vaso.</string>
    <string name="whats_new_5_title">Modo vegetariano</string>
    <string name="whats_new_5_body">Un solo interruptor oculta la carne y el marisco en Inicio, Explorar, la búsqueda y las sugerencias.</string>
