<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Same as Quill: a DayNight window theme whose background matches light/dark mode, so
         nothing flashes white in dark mode before Compose draws the first frame. -->
    <style name="Theme.Ryori" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
    </style>
</resources>
