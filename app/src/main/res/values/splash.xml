<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Animated burger splash (avd_splash_burger): the buns drop in, the patty and lettuce fade
        in, the seeds pop and the shadow grows. The whole build-up runs ~1.12s.
        Background is the burger artwork's cream, with a warm dark tone in dark mode
        (values-night/colors.xml).
    -->
    <style name="Theme.Ryori.SplashScreen" parent="Theme.SplashScreen">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_burger</item>
        <item name="windowSplashScreenAnimationDuration">1200</item>
    </style>
</resources>
