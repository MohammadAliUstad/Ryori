    <string name="more_apps_subtitle">Four more apps, made with the same care</string>
    <string name="more_apps_intro">If you enjoy cooking with Ryori, you might like reading with Quill, keeping track of your money with Mynt, learning Japanese with Hajime and focusing with Sessions.</string>
    <string name="more_apps_get_on_play">Get on Play Store</string>
    <string name="more_apps_overview_title">Cook. Read. Track. Learn. Focus.</string>
    <string name="more_apps_overview_body">Ryori, Quill, Mynt, Hajime and Sessions are made by YugenTech: small, thoughtful apps built to make everyday moments a little calmer.</string>
    <string name="more_apps_sheet_subtitle">Four more apps, made with the same care.</string>
