    <string name="whats_new_1_title">A Home that inspires</string>
    <string name="whats_new_1_body">A featured carousel, a cuisine and a category of the day, and a Surprise me button for when you can\'t decide.</string>
    <string name="whats_new_2_title">Explore every kitchen</string>
    <string name="whats_new_2_body">Browse hundreds of recipes by category, cuisine or ingredient, or search for one by name.</string>
    <string name="whats_new_3_title">Cook along</string>
    <string name="whats_new_3_body">Clear step-by-step instructions, with ingredients you can tick off as you go.</string>
    <string name="whats_new_4_title">Mocktails</string>
    <string name="whats_new_4_body">Non-alcoholic drinks sit right next to the meals, so there\'s something for every glass.</string>
    <string name="whats_new_5_title">Vegetarian mode</string>
    <string name="whats_new_5_body">One switch hides meat and seafood across Home, Explore, search and suggestions.</string>
    <string name="whats_new_6_title">Your chef profile</string>
    <string name="whats_new_6_body">Set your name and watch your kitchen stats grow as you cook.</string>
    <string name="whats_new_7_title">Recently viewed</string>
    <string name="whats_new_7_body">Every recipe you open is kept, so the one from last night is always a tap away.</string>
    <string name="whats_new_8_title">Keep screen on</string>
    <string name="whats_new_8_body">No more tapping the screen with floury fingers while you follow a recipe.</string>
    <string name="whats_new_9_title">Works offline</string>
    <string name="whats_new_9_body">Recipes you\'ve opened are saved on your device, so they load instantly, even without a connection.</string>
    <string name="whats_new_10_title">Make it yours</string>
    <string name="whats_new_10_body">Themes, colors, AMOLED black, fonts and gentle haptics to make Ryori feel like your own kitchen.</string>
    <string name="whats_new_11_title">Speaks your language</string>
    <string name="whats_new_11_body">Ryori comes in 11 languages. It follows your phone, or you can pick another one in Settings.</string>
    <string name="whats_new_12_title">Share and watch</string>
    <string name="whats_new_12_body">Send a recipe to a friend in one tap, or watch its video when there is one.</string>
