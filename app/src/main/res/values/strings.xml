    <string name="credit_design_artist" translatable="false">Pablo Stanley</string>
    <string name="credit_design_body">The beautiful illustrations and doodles used throughout Ryori are created by Pablo Stanley. Big thanks for his amazing contributions to the open design community!</string>
    <string name="credit_lordicon_title">Animated Icons</string>
    <string name="credit_lordicon_subtitle">Provided by Lordicon</string>
    <string name="credit_lordicon_body">The animated Home and Search icons in Ryori\'s navigation bar are provided by Lordicon, a library of high-quality animated assets for creators.</string>
    <string name="credit_lordicon_action">Visit Lordicon</string>
    <string name="credit_oss_title">Ryori is Open Source</string>
    <string name="credit_oss_subtitle">Licensed under GPL-3.0</string>
    <string name="credit_oss_body">The source code is available on GitHub. You are free to use, study, change and share it, as long as anything you share stays open source under the same license. The Ryori name and logo are not included.</string>
    <string name="credit_oss_action">View Source Code</string>
    <string name="quill_feature_1_title" translatable="false">Aira</string>
    <string name="quill_feature_1_body">An AI reading companion that answers from your book, locked to your progress so it never spoils what\'s next.</string>
    <string name="quill_feature_2_title">Character Companion</string>
    <string name="quill_feature_2_body">Recall who someone is, what they\'re up to lately, or trace their whole journey so far.</string>
    <string name="quill_feature_3_title">Visualize Scenes</string>
    <string name="quill_feature_3_body">Turn a passage into an illustration, then jump straight back to where it came from.</string>
    <string name="quill_feature_4_title">A Beautiful Reader</string>
    <string name="quill_feature_4_body">Fonts, spacing, page themes, highlights, night light and paged or scrolling layouts.</string>
    <string name="quill_feature_5_title">Endless Library</string>
    <string name="quill_feature_5_body">Import your own EPUBs or download from 60,000+ free Project Gutenberg and Standard Ebooks titles.</string>
    <string name="quill_feature_6_title">Reading Insights</string>
    <string name="quill_feature_6_body">Streaks, a reading heatmap, peak hours and favorite authors, with gentle daily reminders.</string>
    <string name="quill_tagline">Read Deeper. Think Further.</string>
    <string name="sessions_feature_1_title">Smart Engine</string>
    <string name="sessions_feature_1_body">Customizable cycles and smart intervals that work out when to trigger long breaks.</string>
    <string name="sessions_feature_2_title">Immersive Audio</string>
    <string name="sessions_feature_2_body">6 curated ambient sounds with adaptive ducking and haptic feedback.</string>
    <string name="sessions_feature_3_title">Deep Analytics</string>
    <string name="sessions_feature_3_body">Heatmaps, total focus time and your peak productivity hours at a glance.</string>
    <string name="sessions_feature_4_title">Unkillable</string>
    <string name="sessions_feature_4_body">Built to resist aggressive battery optimization, so your timer never drops.</string>
    <string name="sessions_feature_5_title">Deep Theming</string>
    <string name="sessions_feature_5_body">8 color themes, dynamic Material You, OLED black mode and 6 font options.</string>
    <string name="sessions_feature_6_title">Task History</string>
    <string name="sessions_feature_6_body">Name your sessions to track and review exactly what you worked on.</string>
    <string name="sessions_tagline">Ultimate Pomodoro Timer</string>
    <string name="mynt_feature_1_title">Just Say It</string>
    <string name="mynt_feature_1_body">Tell Mynt what you spent the way you\'d tell a friend. Several things in one sentence become separate entries.</string>
    <string name="mynt_feature_2_title">Lend &amp; Borrow</string>
    <string name="mynt_feature_2_body">Say who you lent to or borrowed from, and when they paid you back. Mynt keeps every balance straight.</string>
    <string name="mynt_feature_3_title">Split Bills</string>
    <string name="mynt_feature_3_body">Split a dinner or a trip between friends just by saying who was there and what it cost.</string>
    <string name="mynt_feature_4_title">Ask About Your Money</string>
    <string name="mynt_feature_4_body">Ask how much you spent on food this month, or who still owes you, and get an answer straight away.</string>
    <string name="mynt_feature_5_title">Check Before Saving</string>
    <string name="mynt_feature_5_body">Everything Mynt understood is shown first, so you can fix an amount or a category before it\'s saved.</string>
    <string name="mynt_feature_6_title">Talks Back</string>
    <string name="mynt_feature_6_body">When something\'s missing, Mynt asks you, and can read its questions aloud so you can answer hands-free.</string>
    <string name="mynt_tagline">Your Voice Money Assistant</string>
    <string name="hajime_feature_1_title">Learn to Read Japanese</string>
    <string name="hajime_feature_1_body">Hiragana and katakana first, then kanji, words and sentences, one short lesson at a time.</string>
    <string name="hajime_feature_2_title">Every JLPT Kanji</string>
    <string name="hajime_feature_2_body">N5 to N1 kanji with readings, meanings, parts, common words and example sentences with furigana.</string>
    <string name="hajime_feature_3_title">Reviews That Remember</string>
    <string name="hajime_feature_3_body">Spaced repetition brings each item back just before you\'d forget it, so what you learn sticks.</string>
    <string name="hajime_feature_4_title">Sensei, Your AI Tutor</string>
    <string name="hajime_feature_4_body">Ask anything about Japanese and get stories, sentence breakdowns and quizzes built from what you\'ve learned.</string>
    <string name="hajime_feature_5_title">Hear Every Word</string>
    <string name="hajime_feature_5_body">Every kana, kanji, word and sentence can be read aloud in a Japanese voice.</string>
    <string name="hajime_feature_6_title">Study Insights</string>
    <string name="hajime_feature_6_body">Streaks, a study heatmap, your trickiest mix-ups and progress through every JLPT level.</string>
    <string name="hajime_tagline">Learn to Read Japanese</string>
