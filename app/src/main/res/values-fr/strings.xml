    <string name="whats_new_1_title">Un accueil qui inspire</string>
    <string name="whats_new_1_body">Un carrousel à la une, une cuisine et une catégorie du jour, et un bouton Surprenez-moi quand vous n\'arrivez pas à choisir.</string>
    <string name="whats_new_2_title">Explorez toutes les cuisines</string>
    <string name="whats_new_2_body">Parcourez des centaines de recettes par catégorie, cuisine ou ingrédient, ou cherchez-en une par son nom.</string>
    <string name="whats_new_3_title">Cuisinez pas à pas</string>
    <string name="whats_new_3_body">Des instructions claires étape par étape, avec des ingrédients à cocher au fur et à mesure.</string>
    <string name="whats_new_4_title">Mocktails</string>
    <string name="whats_new_4_body">Les boissons sans alcool sont juste à côté des plats, il y en a pour tous les verres.</string>
    <string name="whats_new_5_title">Mode végétarien</string>
    <string name="whats_new_5_body">Un seul interrupteur masque la viande et les fruits de mer dans Accueil, Explorer, la recherche et les suggestions.</string>
    <string name="whats_new_6_title">Votre profil de chef</string>
    <string name="whats_new_6_body">Choisissez votre nom et regardez vos statistiques de cuisine grandir au fil de vos recettes.</string>
    <string name="whats_new_7_title">Consultées récemment</string>
    <string name="whats_new_7_body">Chaque recette ouverte est gardée, celle d\'hier soir est donc toujours à portée de doigt.</string>
    <string name="whats_new_8_title">Garder l\'écran allumé</string>
    <string name="whats_new_8_body">Fini de toucher l\'écran avec les doigts pleins de farine pendant que vous suivez une recette.</string>
    <string name="whats_new_9_title">Fonctionne hors ligne</string>
    <string name="whats_new_9_body">Les recettes ouvertes sont enregistrées sur votre appareil : elles se chargent instantanément, même sans connexion.</string>
    <string name="whats_new_10_title">Faites-la vôtre</string>
    <string name="whats_new_10_body">Des thèmes, des couleurs, le noir AMOLED, des polices et des vibrations légères pour que Ryori ressemble à votre propre cuisine.</string>
    <string name="whats_new_11_title">Parle votre langue</string>
    <string name="whats_new_11_body">Ryori existe en 11 langues. Il suit la langue de votre téléphone, ou vous pouvez en choisir une autre dans les Paramètres.</string>
    <string name="whats_new_12_title">Partagez et regardez</string>
    <string name="whats_new_12_body">Envoyez une recette à un ami en un geste, ou regardez sa vidéo quand il y en a une.</string>
