    <string name="credit_design_title">Design et illustrations</string>
    <string name="credit_design_subtitle">Illustrations de</string>
    <string name="credit_design_body">Les belles illustrations et esquisses de Ryori sont l\'œuvre de Pablo Stanley. Un grand merci pour ses formidables contributions à la communauté du design ouvert !</string>
    <string name="credit_lordicon_title">Icônes animées</string>
    <string name="credit_lordicon_subtitle">Fournies par Lordicon</string>
    <string name="credit_lordicon_body">Les icônes animées Accueil et Recherche de la barre de navigation de Ryori sont fournies par Lordicon, une bibliothèque de ressources animées de qualité pour les créateurs.</string>
    <string name="credit_lordicon_action">Visiter Lordicon</string>
    <string name="credit_oss_title">Ryori est open source</string>
    <string name="credit_oss_subtitle">Sous licence GPL-3.0</string>
    <string name="credit_oss_body">Le code source est disponible sur GitHub. Vous êtes libre de l\'utiliser, de l\'étudier, de le modifier et de le partager, à condition que tout ce que vous partagez reste open source sous la même licence. Le nom et le logo Ryori ne sont pas inclus.</string>
    <string name="credit_oss_action">Voir le code source</string>
    <string name="quill_feature_1_body">Un compagnon de lecture IA qui répond à partir de votre livre, limité à votre progression pour ne jamais rien divulgâcher.</string>
    <string name="quill_feature_2_title">Compagnon des personnages</string>
    <string name="quill_feature_2_body">Rappelez-vous qui est quelqu\'un, ce qu\'il fait ces derniers temps, ou retracez tout son parcours jusqu\'ici.</string>
    <string name="quill_feature_3_title">Visualisez les scènes</string>
    <string name="quill_feature_3_body">Transformez un passage en illustration, puis revenez directement à l\'endroit d\'où il vient.</string>
    <string name="quill_feature_4_title">Une liseuse magnifique</string>
    <string name="quill_feature_4_body">Polices, espacement, thèmes de page, surlignages, lumière nocturne et lecture paginée ou continue.</string>
    <string name="quill_feature_5_title">Bibliothèque infinie</string>
    <string name="quill_feature_5_body">Importez vos propres EPUB ou téléchargez parmi plus de 60 000 titres gratuits de Project Gutenberg et Standard Ebooks.</string>
    <string name="quill_feature_6_title">Statistiques de lecture</string>
    <string name="quill_feature_6_body">Séries, carte thermique de lecture, heures de pointe et auteurs préférés, avec des rappels quotidiens bienveillants.</string>
    <string name="quill_tagline">Lisez plus loin. Pensez plus loin.</string>
    <string name="sessions_feature_1_title">Moteur intelligent</string>
    <string name="sessions_feature_1_body">Des cycles personnalisables et des intervalles intelligents qui déterminent quand placer les longues pauses.</string>
    <string name="sessions_feature_2_title">Audio immersif</string>
    <string name="sessions_feature_2_body">6 ambiances sonores sélectionnées, avec atténuation adaptative et retour haptique.</string>
    <string name="sessions_feature_3_title">Analyses détaillées</string>
    <string name="sessions_feature_3_body">Cartes thermiques, temps de concentration total et vos heures les plus productives en un coup d\'œil.</string>
    <string name="sessions_feature_4_title">Increvable</string>
    <string name="sessions_feature_4_body">Conçu pour résister à l\'optimisation agressive de la batterie, pour que votre minuteur ne s\'arrête jamais.</string>
    <string name="sessions_feature_5_title">Thèmes poussés</string>
    <string name="sessions_feature_5_body">8 thèmes de couleur, Material You dynamique, mode noir OLED et 6 polices.</string>
    <string name="sessions_feature_6_title">Historique des tâches</string>
    <string name="sessions_feature_6_body">Nommez vos sessions pour suivre et revoir précisément ce sur quoi vous avez travaillé.</string>
    <string name="sessions_tagline">Le minuteur Pomodoro ultime</string>
    <string name="mynt_feature_1_title">Dites-le simplement</string>
    <string name="mynt_feature_1_body">Dites à Mynt ce que vous avez dépensé comme vous le diriez à un ami. Plusieurs achats dans une phrase deviennent des entrées séparées.</string>
    <string name="mynt_feature_2_title">Prêter et emprunter</string>
    <string name="mynt_feature_2_body">Dites à qui vous avez prêté ou de qui vous avez emprunté, et quand on vous a remboursé. Mynt tient chaque solde à jour.</string>
    <string name="mynt_feature_3_title">Partagez les dépenses</string>
    <string name="mynt_feature_3_body">Partagez un dîner ou un voyage entre amis en disant simplement qui était là et combien ça a coûté.</string>
    <string name="mynt_feature_4_title">Interrogez votre argent</string>
    <string name="mynt_feature_4_body">Demandez combien vous avez dépensé en nourriture ce mois-ci ou qui vous doit encore de l\'argent, et obtenez la réponse aussitôt.</string>
    <string name="mynt_feature_5_title">Vérifiez avant d\'enregistrer</string>
    <string name="mynt_feature_5_body">Tout ce que Mynt a compris s\'affiche d\'abord, pour corriger un montant ou une catégorie avant l\'enregistrement.</string>
    <string name="mynt_feature_6_title">Il vous répond</string>
    <string name="mynt_feature_6_body">Quand il manque quelque chose, Mynt vous le demande et peut lire ses questions à voix haute pour que vous répondiez sans les mains.</string>
    <string name="mynt_tagline">Votre assistant financier vocal</string>
    <string name="hajime_feature_1_title">Apprenez à lire le japonais</string>
    <string name="hajime_feature_1_body">D\'abord les hiragana et katakana, puis les kanji, les mots et les phrases, une courte leçon à la fois.</string>
    <string name="hajime_feature_2_title">Tous les kanji du JLPT</string>
    <string name="hajime_feature_2_body">Les kanji du N5 au N1 avec lectures, sens, composants, mots courants et phrases d\'exemple avec furigana.</string>
    <string name="hajime_feature_3_title">Des révisions qui retiennent</string>
    <string name="hajime_feature_3_body">La répétition espacée ramène chaque élément juste avant que vous ne l\'oubliiez, pour que vos acquis restent.</string>
    <string name="hajime_feature_4_title">Sensei, votre tuteur IA</string>
    <string name="hajime_feature_4_body">Posez n\'importe quelle question sur le japonais et obtenez des histoires, des analyses de phrases et des quiz basés sur ce que vous avez appris.</string>
    <string name="hajime_feature_5_title">Écoutez chaque mot</string>
    <string name="hajime_feature_5_body">Chaque kana, kanji, mot et phrase peut être lu à voix haute par une voix japonaise.</string>
    <string name="hajime_feature_6_title">Statistiques d\'étude</string>
    <string name="hajime_feature_6_body">Séries, carte thermique d\'étude, vos confusions les plus tenaces et votre progression dans chaque niveau du JLPT.</string>
    <string name="hajime_tagline">Apprenez à lire le japonais</string>
    <string name="more_apps_fact_reviews">Plus de 100 avis</string>
    <string name="more_apps_fact_reviews_quill">Plus de 20 avis</string>
