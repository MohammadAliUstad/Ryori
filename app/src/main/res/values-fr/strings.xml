    <string name="more_apps_key_features">Fonctionnalités clés</string>
    <string name="more_apps_subtitle">Quatre autres apps, faites avec le même soin</string>
    <string name="more_apps_intro">Si vous aimez cuisiner avec Ryori, vous aimerez peut-être lire avec Quill, gérer votre argent avec Mynt, apprendre le japonais avec Hajime et vous concentrer avec Sessions.</string>
    <string name="more_apps_get_on_play">Disponible sur le Play Store</string>
    <string name="more_apps_overview_title">Cuisinez. Lisez. Suivez. Apprenez. Concentrez-vous.</string>
    <string name="more_apps_overview_body">Ryori, Quill, Mynt, Hajime et Sessions sont créées par YugenTech : de petites apps soignées pour rendre le quotidien un peu plus serein.</string>
    <string name="more_apps_sheet_subtitle">Quatre autres apps, faites avec le même soin.</string>
