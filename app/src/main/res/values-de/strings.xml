    <string name="more_apps_key_features">Wichtigste Funktionen</string>
    <string name="more_apps_subtitle">Vier weitere Apps, mit derselben Sorgfalt gemacht</string>
    <string name="more_apps_intro">Wenn du gern mit Ryori kochst, gefällt dir vielleicht auch Lesen mit Quill, Finanzen im Blick behalten mit Mynt, Japanisch lernen mit Hajime und konzentriertes Arbeiten mit Sessions.</string>
    <string name="more_apps_get_on_play">Im Play Store holen</string>
    <string name="more_apps_overview_title">Kochen. Lesen. Tracken. Lernen. Fokussieren.</string>
    <string name="more_apps_overview_body">Ryori, Quill, Mynt, Hajime und Sessions stammen von YugenTech: kleine, durchdachte Apps, die den Alltag ein wenig ruhiger machen.</string>
    <string name="more_apps_sheet_subtitle">Vier weitere Apps, mit derselben Sorgfalt gemacht.</string>
    <string name="more_apps_see_all">Alle Funktionen ansehen</string>
